# OpenCyberRange — files an install generates that should not be committed.
#
# Shipped as the .gitignore of the OCR-Lite release. The development repository
# keeps its own, longer list: it names internal audit directories, a secrets
# file convention, and paths belonging to tiers this edition does not carry,
# none of which mean anything to someone running Lite and all of which describe
# a tree they cannot see.

# Secrets — never commit .env (use .env.example as a template)
.env
*.env.local

# Logs
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Node.js
node_modules/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.bak
*.cache

# Lab runtime state. The definitions are tracked; what a running container
# writes underneath them is not.
labs/*/containers/*/app/
labs/*/containers/*/data/
labs/*/containers/*/logs/
!labs/.gitkeep
!labs/*/lab.yaml
!labs/*/docker-compose.yml
!labs/*/README.md
!labs/*/containers/*/Dockerfile

# Key material and certificates — never commit these
*-key.pem
*.key
*.crt
id_rsa
id_ed25519
platform/certs/

# Build output
_site/
_site_*/
_site-*/
# NOTE: platform/frontend/wiki IS shipped (prebuilt track wiki baked into
# the image). Only ignore stray top-level wiki staging dirs.
/wiki/
!platform/frontend/wiki/
platform/frontend/dist/

# Instance state: database dumps, the entitlement file for this install, and
# what the updater records about the last run.
platform/backend/backups/
platform/backend/data/entitlement.instance.json
scripts/.update-state
scripts/deploy.log
