FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    samba \
    && rm -rf /var/lib/apt/lists/*

# ── Samba user for restricted clinical share ─────────────────────────
RUN useradd -M -s /usr/sbin/nologin medsvc && \
    printf 'H4rgr0v3_M3d#\nH4rgr0v3_M3d#\n' | smbpasswd -a -s medsvc

# ── Public share: "public" ───────────────────────────────────────────
RUN mkdir -p /srv/samba/public && \
    printf 'HARGROVE MEDICAL GROUP. WELCOME\n\
=================================\n\
\n\
Welcome to the Hargrove Medical Group internal file server.\n\
\n\
This server hosts shared documents for all three clinic locations.\n\
For IT support, contact the help desk at ext. 2200.\n\
\n\
Please remember: patient data must only be stored on approved,\n\
access-controlled shares. Do not place PHI on public shares.\n\
\n\
- Hargrove IT Department\n' > /srv/samba/public/welcome.txt && \
    printf 'HARGROVE MEDICAL GROUP. IT AUDIT NOTES\n\
==========================================\n\
Date: 2025-11-14\n\
Author: Jason Torres, IT Administrator\n\
\n\
Quarterly audit checklist:\n\
- [x] Verify firewall rules on clinic routers\n\
- [x] Rotate service account passwords (pending clinical share)\n\
- [ ] Migrate backup configs off guest-accessible shares\n\
- [x] Confirm antivirus definitions updated across endpoints\n\
\n\
Internal tracking reference:\n\
audit_token=smb_hunt\n\
\n\
NOTE: The records share still has the old backup_config.ini.\n\
Need to move that to a restricted location before next audit.\n\
- Jason\n' > /srv/samba/public/it_notes.txt && \
    printf 'HARGROVE MEDICAL GROUP. STAFF DIRECTORY\n\
==========================================\n\
\n\
Dr. Ellen Hargrove     . Practice Manager         ext. 2100\n\
Jason Torres           . IT Administrator          ext. 2200\n\
Maria Santos           . Office Manager            ext. 2300\n\
David Chen             . Clinical Systems (medsvc) ext. 2401\n\
\n\
Share access:\n\
- "public"   : All staff (no credentials required)\n\
- "records"  : Administrative backup files\n\
- "clinical" : Restricted. contact David Chen for medsvc access\n' > /srv/samba/public/staff_directory.txt && \
    chmod -R 755 /srv/samba/public

# ── Records share: "records" (guest ok, contains leaked creds) ───────
RUN mkdir -p /srv/samba/records && \
    printf '[backup_service]\n\
schedule = daily\n\
retention_days = 30\n\
target_path = /mnt/backup/nightly\n\
\n\
[clinical_share_access]\n\
; Service account for automated clinical data backups\n\
username = medsvc\n\
password = H4rgr0v3_M3d#\n\
share = //localhost/clinical\n\
\n\
[logging]\n\
log_level = info\n\
log_path = /var/log/backup_svc.log\n' > /srv/samba/records/backup_config.ini && \
    chmod -R 755 /srv/samba/records

# ── Clinical share: "clinical" (restricted, requires medsvc) ────────
RUN mkdir -p /srv/samba/clinical && \
    printf 'cr3ds\n' > /srv/samba/clinical/assessment_marker.txt && \
    printf 'Patient Assessment Summary. Q3 2025\n\
==========================================\n\
Total assessments completed: 1,247\n\
Pending follow-ups: 83\n\
Flagged for review: 12\n\
\n\
Report generated by clinical management system.\n' > /srv/samba/clinical/assessment_summary.txt && \
    chown -R medsvc:medsvc /srv/samba/clinical && \
    chmod -R 770 /srv/samba/clinical

# ── Samba configuration ──────────────────────────────────────────────
RUN printf '[global]\n\
   workgroup = HARGROVE\n\
   server string = Hargrove Medical File Server\n\
   security = user\n\
   map to guest = Bad User\n\
   log file = /var/log/samba/log.%%m\n\
   max log size = 50\n\
\n\
[public]\n\
   path = /srv/samba/public\n\
   browseable = yes\n\
   read only = yes\n\
   guest ok = yes\n\
   comment = Public Documents\n\
\n\
[records]\n\
   path = /srv/samba/records\n\
   browseable = yes\n\
   read only = yes\n\
   guest ok = yes\n\
   comment = Administrative Records\n\
\n\
[clinical]\n\
   path = /srv/samba/clinical\n\
   browseable = yes\n\
   read only = yes\n\
   guest ok = no\n\
   valid users = medsvc\n\
   comment = Clinical Data\n' > /etc/samba/smb.conf

COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 139 445

CMD ["/start.sh"]
