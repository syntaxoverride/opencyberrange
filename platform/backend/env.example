# OpenCyberRange Platform - Environment Configuration
# Copy this file to .env and fill in the values before deployment
# CRITICAL: Never commit .env with real secrets to version control

# ==============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ==============================================================================
# Generate a secure password: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql://labuser:CHANGE_ME_SECURE_PASSWORD@db:5432/labdb

# ==============================================================================
# JWT AUTHENTICATION (REQUIRED)
# ==============================================================================
# Generate a secure secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# Token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins
# Production: Only include your production domain
# Development: Add localhost origins as needed
CORS_ORIGINS=https://lab.yourdomain.com

# ==============================================================================
# WIREGUARD VPN CONFIGURATION
# ==============================================================================
# WireGuard server runs on this same server. Students connect directly.
WG_SERVER_ENDPOINT=YOUR_SERVER_PUBLIC_IP:51820
WG_SERVER_PUBLIC_KEY=YOUR_SERVER_WG_PUBLIC_KEY
WG_API_URL=http://host.docker.internal:5000
WG_API_KEY=your-peer-manager-api-key

# WireGuard private key encryption (RECOMMENDED)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WG_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# Network configuration
WG_NETWORK_BASE=10.100
WG_CLIENT_BASE=10.0.0

# ==============================================================================
# LABS CONFIGURATION
# ==============================================================================
# Absolute path on the HOST to the platform/labs/ directory
# Docker needs this to mount lab volumes into spawned containers
# Example: /opt/opencyberrange/platform/labs
LABS_HOST_PATH=

# ==============================================================================
# HOSTNAME CONFIGURATION
# ==============================================================================
# Main server hostname (for general URLs)
SERVER_PUBLIC_HOST=lab.yourdomain.com

